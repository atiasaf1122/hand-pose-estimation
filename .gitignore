# secrets & environment
.env
.venv/

# datasets & caches
datasets/
*.cache
__pycache__/
*.pyc

# experiment tracking
wandb/

# training outputs — keep ONLY the two required submission videos
# git cannot re-include a file whose parent dir is excluded, so each level
# must be opened explicitly before the two submission clips are un-ignored.
runs/*
!runs/pose/
runs/pose/*
!runs/pose/predict/
runs/pose/predict/*
!runs/pose/predict/failed_attempt.mp4
!runs/pose/predict/successful_attempt.mp4

# model weights (downloadable / regenerated by training)
*.pt

# OS noise
Thumbs.db
.DS_Store

# personal defense notes (Hebrew, not part of the submission repo)
defense_notes_HE.html

# keep the evidence files (small CSV/yaml)
!results/

# local scratch
_from_laptop/
laptop_kit/
laptop_kit.zip
test_advanced.mp4
resume_training.bat
